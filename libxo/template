# chimerautils needs this for df(1)
# held at 1.7.5 for now because 2.x requires byacc
pkg_name=libxo
version=1.7.5
revision=1
build_style=gnu-configure
short_desc="Library for generating text, XML, JSON, and HTML output"
home_page="https://github.com/Juniper/libxo"
license="BSD-2-Clause"
dist_files="https://github.com/Juniper/libxo/releases/download/${version}/libxo-${version}.tar.gz"
checksum="cd95f5b0d3ef604275aef8e0f610087095369e68d934be8d0ff5ea2e223833db"
make_depends="bsd-compat-headers"

use_flags="man static -doc"

configure_args="
    --disable-gettext
    $(use_enable static)"

pre_configure() {
    # libxos build ignores LDFLAGS for some reason, folding them into CFLAGS instead
    CFLAGS="$CFLAGS $LDFLAGS"
    export CFLAGS
}

post_install() {
    use man || brm /usr/share/man

    use doc || brm /usr/share/doc
    blicense Copyright
}
