pkg_name=fastfetch
version=2.68.1
revision=2
build_style=cmake
short_desc="Fast system information tool"
home_page="https://github.com/fastfetch-cli/fastfetch"
license="MIT"
dist_files="https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/${version}.tar.gz>fastfetch-${version}.tar.gz"
checksum="9015957c8012d1b062819297fb9f98f63402a47d7c157dba47f1584740e6301e"
wrk_src="fastfetch-$version"

use_flags="dbus drm elf glib lua vulkan wayland x11 -imagemagick -opencl -pulse -sqlite -vdpau"

depends="zlib $(use_if elf libelf)"
make_depends="cmake pkgconf zlib
 $(use_if dbus dbus)
 $(use_if drm libdrm)
 $(use_if elf libelf)
 $(use_if glib glib)
 $(use_if lua lua)
 $(use_if vulkan vulkan-loader)
 $(use_if wayland "wayland wayland-protocols")
 $(use_if x11 "libX11 libxcb")"

configure_args="
    -DIS_MUSL=ON
    -DSET_TWEAK=OFF
    -DBUILD_TESTS=OFF
    -DENABLE_SYSTEM_YYJSON=OFF
    -DENABLE_DCONF=OFF
    -DENABLE_RPM=OFF
    -DENABLE_DDCUTIL=OFF
    -DENABLE_QUICKJS=OFF
    -DENABLE_XRANDR=OFF
    -DENABLE_VAX11=OFF
    -DENABLE_VADRM=OFF
    -DENABLE_CHAFA=OFF
    -DENABLE_DBUS=$(usev dbus ON OFF)
    -DENABLE_DRM=$(usev drm ON OFF)
    -DENABLE_ELF=$(usev elf ON OFF)
    -DENABLE_GIO=$(usev glib ON OFF)
    -DENABLE_LUA=$(usev lua ON OFF)
    -DENABLE_VULKAN=$(usev vulkan ON OFF)
    -DENABLE_WAYLAND=$(usev wayland ON OFF)
    -DENABLE_XCB_RANDR=$(usev x11 ON OFF)
    -DENABLE_EGL=$(usev x11 ON OFF)
    -DENABLE_GLX=$(usev x11 ON OFF)
    -DENABLE_IMAGEMAGICK6=$(usev imagemagick ON OFF)
    -DENABLE_IMAGEMAGICK7=$(usev imagemagick ON OFF)
    -DENABLE_OPENCL=$(usev opencl ON OFF)
    -DENABLE_PULSE=$(usev pulse ON OFF)
    -DENABLE_SQLITE3=$(usev sqlite ON OFF)
    -DENABLE_VDPAU=$(usev vdpau ON OFF)"
